{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "username", "createdAt", "updatedAt"]
    },
    "Username": {
      "title": "Username Claim",
      "description": "Mapping from username to user id",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "createdAt"]
    },
    "Link": {
      "title": "Link Item",
      "description": "A bio link on user's page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "position": { "type": "number" },
        "visible": { "type": "boolean" },
        "clicks": { "type": "number" },
        "openInNew": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "url", "position", "visible", "clicks", "createdAt", "updatedAt"]
    },
    "Theme": {
      "title": "Theme Config",
      "description": "Appearance settings for user profile page",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "presetId": { "type": "string" },
        "category": { "type": "string" },
        "customizable": { "type": "boolean" },
        "bgType": { "type": "string" },
        "bgColor": { "type": "string" },
        "textColor": { "type": "string" },
        "headingColor": { "type": "string" },
        "buttonColor": { "type": "string" },
        "buttonTextColor": { "type": "string" },
        "buttonStyle": { "type": "string" },
        "buttonShape": { "type": "string" },
        "fontFamily": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "updatedAt"]
    },
    "Socials": {
      "title": "Social Links",
      "description": "User social media handles and site links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Analytics": {
      "title": "Analytics Event",
      "description": "Tracking page view or link click",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "event": { "type": "string" },
        "device": { "type": "string" },
        "referrer": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "event", "createdAt"]
    }
  },
  "firestore": {
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Global unique username registry"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/links/{linkId}": {
      "schema": "Link",
      "description": "Links subcollection for a user"
    },
    "/users/{userId}/theme/default": {
      "schema": "Theme",
      "description": "Theme subcollection document for a user"
    },
    "/users/{userId}/socials/default": {
      "schema": "Socials",
      "description": "Social links subcollection document for a user"
    },
    "/users/{userId}/analytics/{eventId}": {
      "schema": "Analytics",
      "description": "Analytics subcollection for a user"
    }
  }
}
