# ==============================================================================
# LINKVM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary Site URL (Default GitHub Pages subpath deployment)
VITE_SITE_URL="https://aimaeditz.github.io/linkvm/"

# ------------------------------------------------------------------------------
# 🌐 CUSTOM DOMAIN SWITCH (e.g., https://linkvm.online/)
# ------------------------------------------------------------------------------
# Jab custom domain (linkvm.online) khareed ke connect kiya jaye, to:
# 1. Sirf is ek variable ki value change karni hai:
#    VITE_SITE_URL="https://linkvm.online/"
# 2. 'CNAME' file root directory mein add karni hai (jisme 'linkvm.online' likha ho).
# 3. Koi aur file touch nahi karni.
# ------------------------------------------------------------------------------

# Optional Base Path (auto-inferred from VITE_SITE_URL if omitted)
# VITE_BASE_PATH="/linkvm/"

# Optional Server / Database / AI environment variables
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
GEMINI_API_KEY=
