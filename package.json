{
  "name": "linkvm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "app-source"
  ],
  "scripts": {
    "dev": "npm --prefix app-source run dev",
    "build": "npm --prefix app-source run build:root",
    "build:root": "npm --prefix app-source run build:root",
    "install:app": "npm --prefix app-source install",
    "preview": "npm --prefix app-source run preview",
    "lint": "npm --prefix app-source run lint"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
