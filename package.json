{
  "name": "linkvm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "app-source"
  ],
  "scripts": {
    "dev": "cd app-source && npm run dev",
    "build": "cd app-source && npm run build:root",
    "install:app": "cd app-source && npm install",
    "preview": "cd app-source && npm run preview",
    "lint": "cd app-source && npm run lint"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
