rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profiles - anyone can read public profiles, user can manage own
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);

      // Links subcollection
      match /links/{linkId} {
        allow read: if true;
        allow write: if isOwner(userId);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
      }

      // Theme subcollection
      match /theme/{themeId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Socials subcollection
      match /socials/{socialId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Analytics subcollection
      match /analytics/{eventId} {
        allow create: if true;
        allow read, update, delete: if isOwner(userId);
      }
    }

    // Usernames index mapping handle -> uid
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}
