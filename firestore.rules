rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unique username index for routing and availability checks
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // User profiles & public link-in-bio pages
    match /users/{userId} {
      // Public profiles are readable by everyone, editable only by the owner
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Public links
      match /links/{linkId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Public theme settings
      match /theme/{themeId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Public social links
      match /socials/{socialId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Analytics events: anyone can record page views / link clicks; only owner reads
      match /analytics/{analyticsId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Other subcollections
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
